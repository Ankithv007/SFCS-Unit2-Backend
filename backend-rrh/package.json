{
  "name": "backend-rrh",
  "version": "1.0.0",
  "description": "SFCS RRH Master Data Microservice",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --watch src -e ts,js --exec ts-node src/index.ts",
    "build": "tsc",
    "migrate": "ts-node src/db/runMigrations.ts",
    "migrate:rollback": "ts-node src/db/runMigrations.ts --rollback",
    "test": "ts-node tests/runAllTests.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.4",
    "@types/pg": "^8.10.9",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "multer": "^2.4.0",
    "brace-expansion": "^2.1.4",
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.6",
    "micromatch": "^4.0.8",
    "ip-address": "^10.5.1",
    "picomatch": "^4.0.4",
    "pacote": "^21.5.1",
    "sigstore": "^4.1.1",
    "uuid": "^11.1.1",
    "@sigstore/core": "^3.2.1",
    "postcss-selector-parser": "^7.1.3"
  }
}