{
    "compilerOptions": {
        "target": "es2020",
        "lib": ["es2020"],
        "types": ["node", "express"],
        "module": "commonjs",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"]
}